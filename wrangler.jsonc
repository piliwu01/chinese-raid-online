{
  "name": "chinese-raid",
  "account_id": "0eb144462a7f64b05698ab84620a429c",
  "workers_dev": true,
  "main": "server/worker.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/assets/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chinese-raid-db",
      "database_id": "f4727dbc-5c53-4d88-9aa5-cded6974bde4",
      "migrations_dir": "migrations"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "GROQ_KEY",
      "store_id": "1e8ad6c03dba4f56996bfbf28a19fdfb",
      "secret_name": "teaching_api_key"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RAIDS",
        "class_name": "RaidRoom"
      },
      {
        "class_name": "PvpRoom",
        "name": "PVPS"
      }
    ]
  },
  "migrations": [
    {
      "tag": "raid-v1",
      "new_sqlite_classes": [
        "RaidRoom"
      ]
    },
    {
      "tag": "pvp-v1",
      "new_sqlite_classes": [
        "PvpRoom"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
